{
  "name": "check-calo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "android:version:bump": "node scripts/bump-android-version.js",
    "android:bundle": "yarn android:version:bump && cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios --device",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "validate": "yarn type-check && yarn lint && yarn format:check && yarn i18n:check",
    "migrate": "node scripts/migrate.js",
    "scaffold": "node scripts/scaffold.js",
    "doctor": "node scripts/doctor.js",
    "i18n:check": "node scripts/i18n-check.js",
    "check-env": "node scripts/check-env.js",
    "cleanup:anonymous:dry-run": "tsx scripts/cleanup-anonymous-users.ts --dry-run --min-age-days 7 --only-test",
    "cleanup:anonymous": "tsx scripts/cleanup-anonymous-users.ts --min-age-days 7 --only-test",
    "cleanup:storage-images:dry-run": "tsx scripts/cleanup-orphaned-storage-images.ts --dry-run",
